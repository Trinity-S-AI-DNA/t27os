// givel_tma.t27 -- the LAW of the admin Telegram Mini App for the GIVEL bot:
// the admin CRM for the CRM STAFF: the bot owner plus every current member
// of the CRM group (tma_admin_ok checks membership LIVE). The CRM shows what
// the bot already stores (leads, selections, bookings, chat log); v2 writes
// are allowlisted (reply, booking). The chat tab mirrors the client chat.
// ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module GivelTma;

/// The gate covers the CRM STAFF: the owner always passes, and so does any
/// current member of the CRM group -- managers work in the same view.
/// Membership is checked LIVE against Telegram on every session, never
/// copied: leaving the group closes the access on the next check.
pub fn tma_admin_ok(user_id: u32, owner_id: u32, in_group: bool) -> bool {
    return user_id == owner_id or in_group;
}

/// The CRM list is the leads log: every row the bot already wrote.
pub fn crm_row_ok(row: str) -> bool {
    return row != "";
}

/// The chat tab mirrors the client chat the bot already sees; both directions
/// are stored (in = client, out = bot), so the admin reads the full thread.
pub fn chat_direction_ok(dir: str) -> bool {
    return dir == "in" or dir == "out";
}

/// v2 allows exactly TWO writes, both by the admin, both through the bot:
/// "reply" -- an admin message into a client dialog, and "booking" -- the
/// status/time of a viewing booking. The allowlist names the only
/// exceptions; every other write is a violation, not a feature. A reply is
/// bounded: no ten-thousand-character blasts from the web view.
pub const TMA_WRITE_MAX : u32 = 1000;

pub fn tma_write_ok(kind: str) -> bool {
    return kind == "reply" or kind == "booking";
}

pub fn tma_reply_ok(text_len: u32) -> bool {
    if (text_len == 0) { return false; }
    return text_len <= TMA_WRITE_MAX;
}

test the_owner_or_a_group_member_passes {
    assert tma_admin_ok(144022504, 144022504, false) == true;   // owner: no membership needed
    assert tma_admin_ok(42, 144022504, true) == true;           // CRM group member
    assert tma_admin_ok(42, 144022504, false) == false;         // outsider
    assert tma_admin_ok(144022505, 144022504, false) == false;
}

test the_crm_reads_the_leads_log {
    assert crm_row_ok("{}") == true;
    assert crm_row_ok("") == false;
}

test chat_directions_are_in_and_out {
    assert chat_direction_ok("in") == true;
    assert chat_direction_ok("out") == true;
    assert chat_direction_ok("side") == false;
}

test the_only_writes_are_reply_and_booking {
    assert TMA_WRITE_MAX == 1000;
    assert tma_write_ok("reply") == true;
    assert tma_write_ok("booking") == true;
    assert tma_write_ok("delete") == false;
    assert tma_write_ok("edit") == false;
}

/// The client card gathers everything the bot already knows about ONE
/// client: quiz answers, the chat thread, the bookings, the traffic source.
/// The parts allowlist is closed -- a free-form "notes" field would be new
/// data collection, and the card is a merge of existing logs, never more.
pub fn card_part_ok(kind: str) -> bool {
    return kind == "quiz" or kind == "chat" or kind == "bookings" or kind == "source";
}

test the_card_parts_are_four {
    assert card_part_ok("quiz") == true;
    assert card_part_ok("chat") == true;
    assert card_part_ok("bookings") == true;
    assert card_part_ok("source") == true;
    assert card_part_ok("notes") == false;  // v1 stores no free-form notes
}

test the_reply_is_bounded {
    assert tma_reply_ok(1) == true;
    assert tma_reply_ok(1000) == true;
    assert tma_reply_ok(0) == false;
    assert tma_reply_ok(1001) == false;
}

/// The export hands the admin ONE file of what the logs already store,
/// bounded by a period of at most 90 days. A read, not a collection -- and
/// the owner gate applies exactly as to every other call.
pub const EXPORT_MAX_DAYS : u32 = 90;

pub fn export_period_ok(days: u32) -> bool {
    return days > 0 and days <= EXPORT_MAX_DAYS;
}

test the_export_is_bounded {
    assert EXPORT_MAX_DAYS == 90;
    assert export_period_ok(1) == true;
    assert export_period_ok(90) == true;
    assert export_period_ok(0) == false;
    assert export_period_ok(91) == false;
}

/// The client card shows what the client SAW: bookings and selections ride
/// the object's catalog photo. No photo -- no tile, the list stays honest.
pub fn card_photo_ok(photo: str) -> bool {
    return photo != "";
}

test the_card_photo_is_the_catalog_truth {
    assert card_photo_ok("https://media.givelphuket.com/x.webp") == true;
    assert card_photo_ok("") == false;
}

/// The initData the TMA presents may not be older than a day: a captured
/// string stops opening the CRM after INITDATA_MAX_AGE_S seconds. The
/// freshness DECISION is the law's (and crosses into the native binary as
/// a code); the HMAC itself stays host plumbing, like every port here.
pub const INITDATA_MAX_AGE_S : u32 = 86400;

pub fn initdata_fresh(auth_s: u32, now_s: u32) -> bool {
    if (now_s < auth_s) { return false; }
    return (now_s - auth_s) <= INITDATA_MAX_AGE_S;
}

test stale_initdata_stops_opening_the_crm {
    assert initdata_fresh(1000, 1000) == true;
    assert initdata_fresh(1000, 1000 + 86399) == true;
    assert initdata_fresh(1000, 1000 + 86401) == false;
    assert initdata_fresh(2000, 1000) == false;
}

/// The calendar bucket of a viewing: 0 past, 1 today, 2 week, 3 later --
/// from the ms delta the host computes (a clock fact, not a decision).
pub fn cal_bucket(ms_delta: i64) -> u32 {
    if (ms_delta < 0) { return 0; }
    if (ms_delta < 86400000) { return 1; }
    if (ms_delta < 604800000) { return 2; }
    return 3;
}

test cal_buckets_split_the_schedule {
    assert cal_bucket(-5) == 0;
    assert cal_bucket(3600000) == 1;
    assert cal_bucket(90000000) == 2;
    assert cal_bucket(691200000) == 3;
}

/// The client hears a confirmation only when the row ENTERS confirmed --
/// from any other state, exactly once. The codes are the STATUS_* codes of
/// the catalog_media law (1 = confirmed).
pub const TMA_STATUS_CONFIRMED : u32 = 1;

pub fn confirm_notice_code(prev: u32, next: u32) -> bool {
    if (next != TMA_STATUS_CONFIRMED) { return false; }
    return prev != TMA_STATUS_CONFIRMED;
}

test the_client_hears_only_the_first_confirmation {
    assert confirm_notice_code(0, 1) == true;
    assert confirm_notice_code(1, 1) == false;
    assert confirm_notice_code(2, 1) == true;
    assert confirm_notice_code(3, 0) == false;
}

/// ONE login verdict for the whole TMA gate: the shim's tma_check composes
/// the hash check (givel_tma_mac.t27, the HMAC law through the binary) with
/// the freshness law and the admin law into a single integer code, so the
/// host makes ONE spawn per login and decides nothing itself. The codes:
///   0 reject -- the hash does not verify
///   3 reject -- the initData is stale (initdata_fresh)
///   1 allow  -- staff CRM view
///   2 allow  -- admin CRM view (tma_admin_ok)
/// Membership (in_group) arrives from the live Telegram check; the network
/// stays host plumbing, the VERDICT is the law's.
pub fn tma_login(hash_ok: u32, auth_s: u32, now_s: u32, user_id: u32, owner_id: u32, in_group: bool) -> u32 {
    if (hash_ok != 1) {
        return 0;
    }
    if (initdata_fresh(auth_s, now_s) == false) {
        return 3;
    }
    if (tma_admin_ok(user_id, owner_id, in_group)) {
        return 2;
    }
    return 1;
}

test the_login_gate_hashes_first_then_freshness_then_admin {
    const owner : u32 = 144022504;
    const staff : u32 = 42;

    // a bad hash rejects before anything else, even the owner, even fresh
    assert tma_login(0, 1000, 2000, owner, owner, true) == 0;
    assert tma_login(0, 1000, 2000, staff, owner, true) == 0;
    // stale rejects with its own code, owner or not
    assert tma_login(1, 1000, 1000 + 86401, owner, owner, true) == 3;
    assert tma_login(1, 2000, 1000, staff, owner, true) == 3;
    // a fresh hash lets the owner and a live group member into the admin view
    assert tma_login(1, 1000, 2000, owner, owner, false) == 2;
    assert tma_login(1, 1000, 2000, staff, owner, true) == 2;
    // a fresh hash without membership is the read-only staff view
    assert tma_login(1, 1000, 2000, staff, owner, false) == 1;
    // an unknown user outside the group never gets the admin view
    assert tma_login(1, 1000, 2000, 777, owner, false) == 1;
}

/// Which chat-log out-message kinds count in the touch funnel the CRM
/// badge shows. The host translates the log's via word to its code (the
/// table is data, like the texts); this verdict decides what counts.
pub const TOUCH_REMINDER : u32 = 1;
pub const TOUCH_MORNING : u32 = 2;
pub const TOUCH_CONFIRMATION : u32 = 3;

pub fn is_touch_via(code: u32) -> bool {
    return code == TOUCH_REMINDER or code == TOUCH_MORNING or code == TOUCH_CONFIRMATION;
}

test only_the_three_reminder_kinds_count_as_touches {
    assert is_touch_via(TOUCH_REMINDER) == true;
    assert is_touch_via(TOUCH_MORNING) == true;
    assert is_touch_via(TOUCH_CONFIRMATION) == true;
    assert is_touch_via(0) == false;
    assert is_touch_via(4) == false;
}

/// A stat the law could not measure is UNKNOWN, never a fabricated 0 --
/// the CRM badge prints the unknown marker for it. This is the numeric
/// form of the corpus rule "a missing value is not measured, never 0".
pub const STAT_UNKNOWN : i64 = -1;

pub fn stat_or_unknown(measured: bool, n: u32) -> i64 {
    if (measured == false) { return STAT_UNKNOWN; }
    return n as i64;
}

test an_unmeasured_stat_is_unknown_never_zero {
    assert stat_or_unknown(true, 3) == 3;
    assert stat_or_unknown(false, 0) == STAT_UNKNOWN;
    assert stat_or_unknown(true, 0) == 0;
}
