// SPDX-License-Identifier: Apache-2.0
// givel_tma.t27 -- the LAW of the admin Telegram Mini App for the GIVEL bot:
// the admin CRM for the CRM STAFF: the bot owner plus every current member
// of the CRM group (tma_admin_ok checks membership LIVE). The CRM shows what
// the bot already stores (leads, selections, bookings, chat log); v2 writes
// are allowlisted (reply, booking). The chat tab mirrors the client chat.
// ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module GivelTma;

/// The gate covers the CRM STAFF: the owner always passes, and so does any
/// current member of the CRM group -- managers work in the same view.
/// Membership is checked LIVE against Telegram on every session, never
/// copied: leaving the group closes the access on the next check.
pub fn tma_admin_ok(user_id: u32, owner_id: u32, in_group: bool) -> bool {
    return user_id == owner_id or in_group;
}

/// The CRM list is the leads log: every row the bot already wrote.
pub fn crm_row_ok(row: str) -> bool {
    return row != "";
}

/// The chat tab mirrors the client chat the bot already sees; both directions
/// are stored (in = client, out = bot), so the admin reads the full thread.
pub fn chat_direction_ok(dir: str) -> bool {
    return dir == "in" or dir == "out";
}

/// v2 allows exactly TWO writes, both by the admin, both through the bot:
/// "reply" -- an admin message into a client dialog, and "booking" -- the
/// status/time of a viewing booking. The allowlist names the only
/// exceptions; every other write is a violation, not a feature. A reply is
/// bounded: no ten-thousand-character blasts from the web view.
pub const TMA_WRITE_MAX : u32 = 1000;

pub fn tma_write_ok(kind: str) -> bool {
    return kind == "reply" or kind == "booking";
}

pub fn tma_reply_ok(text_len: u32) -> bool {
    if (text_len == 0) { return false; }
    return text_len <= TMA_WRITE_MAX;
}

test the_owner_or_a_group_member_passes {
    assert tma_admin_ok(144022504, 144022504, false) == true;   // owner: no membership needed
    assert tma_admin_ok(42, 144022504, true) == true;           // CRM group member
    assert tma_admin_ok(42, 144022504, false) == false;         // outsider
    assert tma_admin_ok(144022505, 144022504, false) == false;
}

test the_crm_reads_the_leads_log {
    assert crm_row_ok("{}") == true;
    assert crm_row_ok("") == false;
}

test chat_directions_are_in_and_out {
    assert chat_direction_ok("in") == true;
    assert chat_direction_ok("out") == true;
    assert chat_direction_ok("side") == false;
}

test the_only_writes_are_reply_and_booking {
    assert TMA_WRITE_MAX == 1000;
    assert tma_write_ok("reply") == true;
    assert tma_write_ok("booking") == true;
    assert tma_write_ok("delete") == false;
    assert tma_write_ok("edit") == false;
}

/// The client card gathers everything the bot already knows about ONE
/// client: quiz answers, the chat thread, the bookings, the traffic source.
/// The parts allowlist is closed -- a free-form "notes" field would be new
/// data collection, and the card is a merge of existing logs, never more.
pub fn card_part_ok(kind: str) -> bool {
    return kind == "quiz" or kind == "chat" or kind == "bookings" or kind == "source";
}

test the_card_parts_are_four {
    assert card_part_ok("quiz") == true;
    assert card_part_ok("chat") == true;
    assert card_part_ok("bookings") == true;
    assert card_part_ok("source") == true;
    assert card_part_ok("notes") == false;  // v1 stores no free-form notes
}

test the_reply_is_bounded {
    assert tma_reply_ok(1) == true;
    assert tma_reply_ok(1000) == true;
    assert tma_reply_ok(0) == false;
    assert tma_reply_ok(1001) == false;
}

/// The export hands the admin ONE file of what the logs already store,
/// bounded by a period of at most 90 days. A read, not a collection -- and
/// the owner gate applies exactly as to every other call.
pub const EXPORT_MAX_DAYS : u32 = 90;

pub fn export_period_ok(days: u32) -> bool {
    return days > 0 and days <= EXPORT_MAX_DAYS;
}

test the_export_is_bounded {
    assert EXPORT_MAX_DAYS == 90;
    assert export_period_ok(1) == true;
    assert export_period_ok(90) == true;
    assert export_period_ok(0) == false;
    assert export_period_ok(91) == false;
}
