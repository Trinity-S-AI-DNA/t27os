/// Source spellings that are neither the EN nor the RU name, counted on the
/// live catalog of 2026-11-09 (whitespace already collapsed). ALIAS_TO[i] is
/// the place of ALIAS_FROM[i].
pub const ALIAS_COUNT : u32 = 62;

pub const ALIAS_FROM : [62]str = [
    "Бангтао", "Bangtao", "Банг тао", "Банг-Тао", "BangTao", "БангТао", "Bangthao",
    "Равай", "Talang", "Талан", "Чернгталай", "Cherngtalay",
    "Найянг", "Naiyang", "Най-Янг", "Наянг", "Laguna Phuket", "Лагуна (Laguna)",
    "Лаян (Bang Tao)", "Surin Beach", "Найхарн", "Найтон", "Katu", "Май Као",
    "Ко Каео", "Кох Кео", "Паттайя Джомтьен", "Паттайя р-н Джомтьен",
    "Джомтьен Паттайя", "Mile of Millionaires", "Central Phuket area",
    "Равай/Най Харн", "Naiharn/Rawai", "Лагуна / Бангтао", "Laguna/Bangtao",
    "Банг Тао (Сурин)", "Surin/Bang Tao", "Bang Tao / Cherngtalay",
    "между Патонгом и Кату", "Самуи Банг Рак", "Паттайя р-н Таппрая",
    "Паттайя р-н На-Джомтьен", "Паттайя Третья улица", "Паттайя р-н На-Клуа",
    "Паттайя р-н Банг-Сарай", "Паттайя Банг-Сарей", "Паттайя Холм Пратамнак",
