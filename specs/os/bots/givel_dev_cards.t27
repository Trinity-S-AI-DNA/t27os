// SPDX-License-Identifier: Apache-2.0
// givel_dev_cards.t27 -- PROACTIVE DEVELOPMENT CARDS for the GIVEL funnel:
// the bot writes first, offering a client their top options to move faster.
// Proactivity is bounded by law: a real open state to act on, a cooldown
// between touches, the client's opt-out is absolute, and nothing arrives at
// night. The card names at most THREE options -- the highest-impact ones
// first (Pareto). ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module GivelDevCards;

/// Hours between proactive touches: a card at most every TWO days.
pub const CARD_COOLDOWN_H : u32 = 48;

/// Pareto: the card names at most THREE options -- the highest-impact ones
/// first. The fourth-best option is noise.
pub const CARD_MAX_OPTIONS : u32 = 3;

/// The quiet window (ICT hours): cards arrive between 09:00 and 21:00 local.
pub const CARD_QUIET_FROM : u32 = 9;
pub const CARD_QUIET_TO : u32 = 21;

/// A card is due when the client has not opted out and the cooldown passed.
/// The opt-out is absolute: a client who said stop is never written first.
pub fn card_due(hours_since_touch: u32, opted_out: bool) -> bool {
    if (opted_out) { return false; }
    return hours_since_touch >= CARD_COOLDOWN_H;
}

/// Nothing arrives at night: the send hour (ICT) must sit in the window.
pub fn card_hour_ok(hour_ict: u32) -> bool {
    if (hour_ict < CARD_QUIET_FROM) { return false; }
    return hour_ict < CARD_QUIET_TO;
}

/// Pareto cap: however many options the state offers, the card names the
/// top three.
pub fn pareto_cap(option_count: u32) -> u32 {
    if (option_count > CARD_MAX_OPTIONS) { return CARD_MAX_OPTIONS; }
    return option_count;
}

/// Only OPEN states get cards: a fresh lead, a selection without a booking,
/// an upcoming viewing, a repeat client. Done and cancelled are closed
/// histories -- no card follows them.
pub fn card_state_ok(status: str) -> bool {
    return status == "new_lead" or status == "has_selection" or status == "booked" or status == "repeat";
}

test the_card_is_due_on_cooldown_and_consent {
    assert CARD_COOLDOWN_H == 48;
    assert card_due(48, false) == true;
    assert card_due(47, false) == false;
    assert card_due(500, true) == false;
}

test nothing_arrives_at_night {
    assert CARD_QUIET_FROM == 9;
    assert CARD_QUIET_TO == 21;
    assert card_hour_ok(12) == true;
    assert card_hour_ok(3) == false;
    assert card_hour_ok(22) == false;
}

test pareto_caps_at_three {
    assert CARD_MAX_OPTIONS == 3;
    assert pareto_cap(5) == 3;
    assert pareto_cap(2) == 2;
    assert pareto_cap(0) == 0;
}

test only_open_states_get_cards {
    assert card_state_ok("new_lead") == true;
    assert card_state_ok("has_selection") == true;
    assert card_state_ok("booked") == true;
    assert card_state_ok("repeat") == true;
    assert card_state_ok("done") == false;
}

/// The card carries PROOF: for a client with a past selection, up to TWO
/// objects from that selection ride inside the card (photo + booking
/// button) -- from advice to action in one tap.
pub const CARD_OBJECTS_MAX : u32 = 2;

pub fn card_objects_cap(count: u32) -> u32 {
    if (count > CARD_OBJECTS_MAX) { return CARD_OBJECTS_MAX; }
    return count;
}

/// An option's rank is EARNED, in integer basis points: converted * 10000 /
/// shown. An option never shown has no rank and keeps the hand order -- the
/// law's order is the prior, the data is the update.
pub fn option_rank_bp(converted: u32, shown: u32) -> u32 {
    if (shown == 0) { return 0; }
    return converted * 10000 / shown;
}

/// A card composed at night does not die: it waits in the queue and goes
/// out at the next send, which is always inside the window. It waits ONE
/// day -- older than that it is stale and dropped.
pub const QUEUE_MAX_AGE_H : u32 = 24;

pub fn queue_ok(age_h: u32) -> bool {
    return age_h <= QUEUE_MAX_AGE_H;
}

test the_card_carries_two_objects {
    assert CARD_OBJECTS_MAX == 2;
    assert card_objects_cap(5) == 2;
    assert card_objects_cap(1) == 1;
    assert card_objects_cap(0) == 0;
}

test the_rank_is_earned_in_basis_points {
    assert option_rank_bp(3, 10) == 3000;
    assert option_rank_bp(0, 5) == 0;
    assert option_rank_bp(1, 0) == 0;   // never shown: hand order stands
}

test the_queue_holds_a_card_for_one_day {
    assert QUEUE_MAX_AGE_H == 24;
    assert queue_ok(0) == true;
    assert queue_ok(24) == true;
    assert queue_ok(25) == false;
}

/// The opt-out rides ON the card: one press, no typing. The law's opt-out
/// is only as real as its cheapest path.
pub const OPTOUT_ON_CARD : bool = true;

/// The cooldown is PERSONAL to the state: a hot lead hears every two days,
/// a repeat client once a week -- and a booked client gets NO dev card at
/// all, because the viewing reminder already owns that thread.
pub const COOLDOWN_HOT_LEAD_H : u32 = 48;
pub const COOLDOWN_REPEAT_H : u32 = 168;

pub fn cooldown_for(state: str, fallback_h: u32) -> u32 {
    if (state == "repeat") { return COOLDOWN_REPEAT_H; }
    return fallback_h;
}

pub fn dev_card_allowed(state: str) -> bool {
    return state != "booked";
}

test the_cooldown_is_personal {
    assert COOLDOWN_HOT_LEAD_H == 48;
    assert COOLDOWN_REPEAT_H == 168;
    assert cooldown_for("repeat", 48) == 168;
    assert cooldown_for("new_lead", 48) == 48;
}

test booked_hears_the_reminder_not_the_cards {
    assert dev_card_allowed("booked") == false;
    assert dev_card_allowed("new_lead") == true;
    assert dev_card_allowed("repeat") == true;
}

/// The button exists on every composed card -- the host asserts the wiring
/// in its own tests; the law pins the rule the wiring serves.
pub fn optout_button_rule(card_keyboard_rows: u32, has_optout_row: bool) -> bool {
    if (card_keyboard_rows == 0) { return false; }
    if (OPTOUT_ON_CARD) { return has_optout_row; }
    return true;
}

test every_card_keyboard_carries_the_optout {
    assert optout_button_rule(0, false) == false;   // an empty card is not a card
    assert optout_button_rule(2, true) == true;
    assert optout_button_rule(2, false) == false;   // the law's button is not optional
}

/// A rank learns from clicks before it learns from bookings: a press of the
/// card's button within a day of the card credits the card's options. The
/// click is common; the booking is rare -- and both are evidence.
pub const CLICK_CREDIT_WINDOW_H : u32 = 24;
