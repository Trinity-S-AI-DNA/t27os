// SPDX-License-Identifier: Apache-2.0
// givel_catalog_media.t27 -- the LAW of catalog media and viewing bookings for
// the GIVEL bot: how search hits become photo cards (and fall back to text),
// how a client books a viewing with one button press, and when the AI answer
// is allowed to name catalog objects. Measured 2026-10-25: catalog photos are
// Google Drive thumbnails, most public, some private -- so a photo failure is
// EXPECTED and must never cost the client their answer. The host owns the
// HTTP and string primitives; this spec fixes the CONSTANTS and DECISION
// rules, each checked by the compilers.
// Companion laws: givel_catalog_search.t27 (search accept/reject),
// givel_lead_bot.t27 (quiz leads, ID standard), givel_ai_models.t27 (ladder).
// ASCII only (L3).
; phi^2 + 1/phi^2 = 3 | TRINITY

module GivelCatalogMedia;

/// At most 3 photo cards per answer (Telegram rate sense, one screen).
pub const PHOTOS_MAX : u32 = 3;
/// The AI may name at most this many catalog objects (same cap as the search).
pub const HINT_LIMIT : u32 = 3;
/// callback_data prefix of the one-press viewing booking: book:<GV-OBJ id>.
pub const BOOKING_PREFIX : str = "book:";

/// The booking prefix is data, not a literal scattered through the host.
pub fn booking_prefix() -> str {
    return BOOKING_PREFIX;
}

/// The soft AI hint fires on ANY single search signal. The strict card search
/// runs first and takes the full signal set; the hint may still run where the
/// cards did not, so the model names real objects, not inventions.
pub fn hint_ok(has_district: bool, has_type: bool, has_budget: bool) -> bool {
    return has_district or has_type or has_budget;
}

/// A hit renders as a photo card only when the object HAS a photo AND the
/// platform accepted it.
pub fn photo_card(has_photo: bool, sent_ok: bool) -> bool {
    return has_photo and sent_ok;
}

/// Everything else falls back to the text card. The fallback is not optional:
/// a private or unreachable photo never blocks the answer.
pub fn falls_back(has_photo: bool, sent_ok: bool) -> bool {
    if (has_photo and sent_ok) { return false; }
    return true;
}

/// The photo stream is capped no matter how many hits carry photos.
pub fn cards_cap(requested: u32) -> u32 {
    if (requested > PHOTOS_MAX) { return PHOTOS_MAX; }
    return requested;
}

/// A viewing booking is a DIRECT lead (no quiz): the object is already chosen,
/// so the record is complete with the object id and the user alone.
pub fn direct_lead_ok(has_object_id: bool, has_user: bool) -> bool {
    return has_object_id and has_user;
}

test the_caps_are_three {
    assert PHOTOS_MAX == 3;
    assert HINT_LIMIT == 3;
    assert cards_cap(3) == 3;
    assert cards_cap(5) == 3;
    assert cards_cap(0) == 0;
    assert cards_cap(1) == 1;
}

test the_booking_prefix_is_fixed {
    assert booking_prefix() == "book:";
    assert booking_prefix() != "";
}

test hint_fires_on_any_single_signal {
    assert hint_ok(true, false, false) == true;
    assert hint_ok(false, true, false) == true;
    assert hint_ok(false, false, true) == true;
    assert hint_ok(true, true, true) == true;
    assert hint_ok(false, false, false) == false;
}

test a_photo_failure_falls_back_to_text {
    assert photo_card(true, true) == true;
    assert photo_card(false, true) == false;   // no photo: text card
    assert photo_card(true, false) == false;   // send failed: text card
    assert falls_back(true, true) == false;
    assert falls_back(true, false) == true;    // measured: private Drive photo
    assert falls_back(false, false) == true;
    assert falls_back(false, true) == true;
}

test a_viewing_lead_is_direct_but_complete {
    assert direct_lead_ok(true, true) == true;
    assert direct_lead_ok(true, false) == false;
    assert direct_lead_ok(false, true) == false;
    assert direct_lead_ok(false, false) == false;
}

/// The quiz speaks USD, the catalog speaks THB: the fixed rate of the
/// selection (re-measure against the baht before changing).
pub const USD_THB : u32 = 37;

pub fn quiz_budget_thb(usd: u32) -> u32 {
    return usd * USD_THB;
}

/// A finished quiz produces a selection when at least one search signal
/// came out of it (same rule as the AI hint, different source of signals).
pub fn quiz_selection_ok(has_interest: bool, has_location: bool, has_budget: bool) -> bool {
    return has_interest or has_location or has_budget;
}

test the_quiz_selection_rules {
    assert USD_THB == 37;
    assert quiz_budget_thb(200_000) == 7_400_000;
    assert quiz_budget_thb(0) == 0;
    assert quiz_selection_ok(true, false, false) == true;
    assert quiz_selection_ok(false, true, true) == true;
    assert quiz_selection_ok(false, false, false) == false;
}

/// The weekly digest speaks with three verdicts only: SCALE (bookings exist --
/// buy traffic), REOFFER (enough shows, zero bookings -- change the offer),
/// WAIT (not enough shows to judge).
pub const DIGEST_MIN_SHOWS : u32 = 20;

pub fn digest_verdict(shows: u32, bookings: u32) -> str {
    if (bookings > 0) { return "SCALE"; }
    if (shows >= DIGEST_MIN_SHOWS) { return "REOFFER"; }
    return "WAIT";
}

test the_digest_has_three_verdicts {
    assert DIGEST_MIN_SHOWS == 20;
    assert digest_verdict(25, 0) == "REOFFER";
    assert digest_verdict(5, 0) == "WAIT";
    assert digest_verdict(5, 2) == "SCALE";
    assert digest_verdict(50, 1) == "SCALE";
}

/// The conversion loop: an object that CLOSED a viewing before ranks above
/// objects that never did; ties fall through to the price sort of the search
/// law. Bookings come from leads.jsonl rows of type "viewing".
pub const MIN_BOOKINGS_TO_BOOST : u32 = 1;

pub fn boosts(bookings: u32) -> bool {
    return bookings >= MIN_BOOKINGS_TO_BOOST;
}

pub fn booked_ranks_higher(bookings_a: u32, bookings_b: u32) -> bool {
    if (bookings_a > bookings_b) { return true; }
    return false;
}

test booked_objects_rank_first {
    assert MIN_BOOKINGS_TO_BOOST == 1;
    assert boosts(1) == true;
    assert boosts(0) == false;
    assert booked_ranks_higher(2, 0) == true;
    assert booked_ranks_higher(0, 1) == false;
    assert booked_ranks_higher(1, 1) == false;  // tie: price sort decides
}

/// No repeats while fresh options remain: a returning client sees objects
/// they have NOT been shown before; when fresh options run out, the pool
/// falls back to repeats. Exclusion is data-driven (metrics.jsonl).
pub fn exclude_seen(shown_before: bool, fresh_left: u32) -> bool {
    if (shown_before and fresh_left > 0) { return true; }
    return false;
}

test seen_objects_are_excluded_while_fresh_remain {
    assert exclude_seen(true, 3) == true;   // shown before, fresh exist: skip
    assert exclude_seen(true, 0) == false;  // fresh exhausted: repeats allowed
    assert exclude_seen(false, 3) == false; // never shown: primary candidate
}

/// The follow-up rule: a client who started the quiz and went silent for 24
/// hours gets ONE gentle reminder with a single object card. One reminder,
/// never two -- politeness is part of the law.
pub const FOLLOWUP_AFTER_H : u32 = 24;

pub fn followup_due(hours_since_start: u32, already_followed: bool) -> bool {
    if (already_followed) { return false; }
    return hours_since_start >= FOLLOWUP_AFTER_H;
}

/// ONE verdict per candidate row per followup pass: the shim feeds the
/// set-difference verdict (follow_needed, the batch law) plus the row's
/// freshness and completion facts, and this composes them -- the host
/// decides nothing.
///   0 skip, 1 follow owed
pub fn follow_tick(hours_since_start: u32, completed: bool, set_verdict: u32) -> u32 {
    if (followup_due(hours_since_start, (set_verdict == 0) or completed)) { return 1; }
    return 0;
}

test the_follow_tick_composes_set_freshness_and_completion {
    assert follow_tick(24, false, 1) == 1;
    assert follow_tick(48, true, 1) == 0;
    assert follow_tick(48, false, 0) == 0;
    assert follow_tick(23, false, 1) == 0;
}

test the_followup_fires_once_after_a_day {
    assert FOLLOWUP_AFTER_H == 24;
    assert followup_due(24, false) == true;
    assert followup_due(23, false) == false;
    assert followup_due(72, true) == false;  // one reminder, never two
}

/// The managers' SLA: a viewing booking must be answered within ONE hour.
/// The watchdog measures booking -> first manager message in the Leads thread
/// and counts the breaches; responsibility becomes a metric.
pub const SLA_MAX_H : u32 = 1;

pub fn sla_ok(response_min: u32) -> bool {
    return response_min <= SLA_MAX_H * 60;
}

test the_sla_is_one_hour {
    assert SLA_MAX_H == 1;
    assert sla_ok(60) == true;
    assert sla_ok(61) == false;
    assert sla_ok(0) == true;
}

/// A viewing booking lives a four-state life; the status is data, not
/// memory, so the TMA, the digest and the managers read the same truth.
pub fn booking_status_ok(s: str) -> bool {
    return s == "booked" or s == "confirmed" or s == "done" or s == "cancelled";
}

test booking_statuses_are_four {
    assert booking_status_ok("booked") == true;
    assert booking_status_ok("confirmed") == true;
    assert booking_status_ok("done") == true;
    assert booking_status_ok("cancelled") == true;
    assert booking_status_ok("maybe") == false;
}

/// The client hears about the viewing BEFORE it starts: one reminder,
/// REMIND_BEFORE_H hours ahead, never twice, and never after the window
/// closes (an hour past the start the reminder is noise, not help).
pub const REMIND_BEFORE_H : u32 = 2;

pub fn remind_due(ms_until_start: i64, already_reminded: bool) -> bool {
    if (already_reminded) { return false; }
    return ms_until_start <= REMIND_BEFORE_H * 3600000 and ms_until_start > -3600000;
}

test the_reminder_fires_once_two_hours_before {
    assert REMIND_BEFORE_H == 2;
    assert remind_due(3600000, false) == true;    // 1h before: due
    assert remind_due(7200000, false) == true;    // exactly 2h: due
    assert remind_due(10800000, false) == false;  // 3h before: too early
    assert remind_due(3600000, true) == false;    // once, never twice
}

/// Photo coverage is measured, integer percent: the digest states how much
/// of the catalog the client can actually SEE. A missing photo is a visible
/// gap, not silence.
pub fn photo_coverage_pct(with_photo: u32, total: u32) -> u32 {
    if (total == 0) { return 0; }
    return with_photo * 100 / total;
}

test coverage_is_integer_percent {
    assert photo_coverage_pct(158, 473) == 33;
    assert photo_coverage_pct(0, 5) == 0;
    assert photo_coverage_pct(5, 5) == 100;
    assert photo_coverage_pct(7, 0) == 0;
}

/// The calendar buckets viewings by DAY-distance: today, this week, later.
/// A booking without a time is not on the calendar -- it is a lead, not an
/// appointment; and a start already an hour past belongs to "past".
pub fn calendar_bucket(ms_until_start: i64) -> str {
    if (ms_until_start < 0) { return "past"; }
    if (ms_until_start < 86400000) { return "today"; }
    if (ms_until_start < 7 * 86400000) { return "week"; }
    return "later";
}

test the_calendar_buckets {
    assert calendar_bucket(-3600000) == "past";       // started an hour ago
    assert calendar_bucket(0) == "today";             // starting now
    assert calendar_bucket(3600000) == "today";       // 1h ahead
    assert calendar_bucket(2 * 86400000) == "week";   // in two days
    assert calendar_bucket(30 * 86400000) == "later"; // in a month
}

/// The digest states the funnel PER SOURCE: a channel is proven by its own
/// show -> lead -> booking chain, not by a global average. A source with no
/// events at all is not in the table.
pub fn source_funnel_ok(shown: u32, leads: u32, bookings: u32) -> bool {
    return shown > 0 or leads > 0 or bookings > 0;
}

test a_source_needs_at_least_one_event {
    assert source_funnel_ok(1, 0, 0) == true;
    assert source_funnel_ok(0, 2, 0) == true;
    assert source_funnel_ok(0, 0, 1) == true;
    assert source_funnel_ok(0, 0, 0) == false;
}

/// Staff activity is counted from the chat mirror: a CRM reply carries its
/// author (who), so the weekly digest makes replies personal and
/// comparable. A reply without an author is not countable.
pub fn staff_reply_ok(who: str) -> bool {
    return who != "";
}

test a_reply_needs_an_author {
    assert staff_reply_ok("@rubanlina") == true;
    assert staff_reply_ok("") == false;
}

/// The reminder speaks the CLIENT's language: the client's own words decide
/// (cyrillic -> ru, else en -- the same rule that runs the funnel). The
/// manager sets the time; the law sets the tongue.
pub fn reminder_lang(has_cyrillic: bool) -> str {
    if (has_cyrillic) { return "ru"; }
    return "en";
}

test the_reminder_speaks_the_clients_tongue {
    assert reminder_lang(true) == "ru";
    assert reminder_lang(false) == "en";
}

/// A booking the staff CONFIRMS owes the client an instant confirmation:
/// the client hears it from the bot the moment the status changes, not at
/// the reminder. The notice fires on the TRANSITION into confirmed -- never
/// a second time for the same state.
pub fn confirm_notice(prev_status: str, new_status: str) -> bool {
    return prev_status != "confirmed" and new_status == "confirmed";
}

test the_client_hears_the_confirmation_once {
    assert confirm_notice("booked", "confirmed") == true;
    assert confirm_notice("confirmed", "confirmed") == false;  // no repeat
    assert confirm_notice("done", "confirmed") == true;
}

/// The digest splits the funnel BY LANGUAGE: the EN funnel either produces
/// or it does not -- a global average hides which. A split with no clients
/// at all is not a split.
pub fn lang_split_ok(ru: u32, en: u32) -> bool {
    return ru > 0 or en > 0;
}

test the_split_needs_clients {
    assert lang_split_ok(1, 0) == true;
    assert lang_split_ok(0, 1) == true;
    assert lang_split_ok(0, 0) == false;
}

/// The A/B verdict: photo cards vs text cards, decided on a >=50-show sample.
/// Conversions are integer basis points (bookings * 10000 / users) so no float
/// sneaks into the law. The winner is announced in the weekly digest and the
/// LOSING format is disabled by the host automatically -- no debate, no drift.
pub const AB_MIN_SAMPLE : u32 = 50;

pub fn ab_winner(photo_bp: u32, text_bp: u32) -> str {
    if (photo_bp > text_bp) { return "PHOTO"; }
    if (text_bp > photo_bp) { return "TEXT"; }
    return "WAIT";
}

test the_ab_verdict_needs_fifty_shows {
    assert AB_MIN_SAMPLE == 50;
    assert ab_winner(500, 300) == "PHOTO";
    assert ab_winner(300, 500) == "TEXT";
    assert ab_winner(400, 400) == "WAIT";
}

/// The client picks the viewing TIME from the bot's slots -- the manager
/// only confirms. A slot is valid when it is in the future and within 14
/// days.
pub const SLOT_DAYS_AHEAD : u32 = 14;

pub fn slot_ok(start_ms: i64, now_ms: i64) -> bool {
    return start_ms > now_ms and start_ms <= now_ms + SLOT_DAYS_AHEAD * 86400000;
}

test slots_are_future_and_bounded {
    assert SLOT_DAYS_AHEAD == 14;
    assert slot_ok(3600000, 0) == true;
    assert slot_ok(-1, 0) == false;
    assert slot_ok(15 * 86400000, 0) == false;
}

/// The SHOWCASE Pareto: an object enters the table only after it was SHOWN
/// to a client, and a booking credits the shows that preceded it. The
/// table is built from the logs -- no new collection.
pub fn object_table_row_ok(shown: u32) -> bool {
    return shown > 0;
}

test the_showcase_table_is_evidence {
    assert object_table_row_ok(1) == true;
    assert object_table_row_ok(0) == false;
}

/// The last touch before the visit: one SHORT note on the MORNING of the
/// viewing day, in the client's language. Once -- the 2h reminder already
/// exists and stays.
pub const MORNING_NOTE : bool = true;

pub fn morning_due(is_morning_ict: bool, note_sent: bool) -> bool {
    if (note_sent) { return false; }
    return MORNING_NOTE and is_morning_ict;
}

test the_morning_note_fires_once {
    assert MORNING_NOTE == true;
    assert morning_due(true, false) == true;
    assert morning_due(true, true) == false;
    assert morning_due(false, false) == false;
}

/// The weekly digest is PINNED in the CRM group: the staff reads metrics
/// without opening anything. A new digest replaces the old pin -- there is
/// always exactly one pinned digest.
pub const DIGEST_PINNED : bool = true;

pub fn digest_pin_rule(has_new_digest: bool) -> bool {
    if (DIGEST_PINNED and has_new_digest) { return true; }
    return false;
}

test the_digest_is_pinned {
    assert DIGEST_PINNED == true;
    assert digest_pin_rule(true) == true;
    assert digest_pin_rule(false) == false;
}

/// The confirmation and both reminders ride the object's PHOTO when the
/// catalog serves one: a person sees where they are going, days and hours
/// before the visit. No photo -- the text goes alone (falls back, never
/// blocks).
pub fn notice_photo_ok(photo: str) -> bool {
    return photo != "";
}

test the_notice_rides_the_photo {
    assert notice_photo_ok("https://media.givelphuket.com/x.webp") == true;
    assert notice_photo_ok("") == false;
}

/// A slot the client picked but the staff has not confirmed pings the CRM
/// group after two hours: the loop closes on people, not on silence. The
/// ping fires once -- the slot_pinged flag remembers.
pub const SLOT_PING_H : u32 = 2;

/// ONE verdict per booking row per remind pass: the host asks once and
/// acts on the code instead of spawning three times (the row's missing
/// fields travel as neutral values -- no row.at means a huge ms_until,
/// no slot_pick_ts means 0 hours -- and the windows stay closed).
///   0 nothing due, 1 reminder due, 2 morning note due, 3 slot ping due
/// Priority follows the host's pass order: reminder > morning > ping.
pub fn remind_tick(ms_until_start: i64, already_reminded: bool,
                   is_morning_ict: bool, note_sent: bool,
                   hours_since_pick: u32, confirmed: bool, pinged: bool) -> u32 {
    if (remind_due(ms_until_start, already_reminded)) { return 1; }
    if (morning_due(is_morning_ict, note_sent)) { return 2; }
    if (slot_ping_due(hours_since_pick, confirmed, pinged)) { return 3; }
    return 0;
}

test the_tick_answers_one_verdict_per_row {
    assert remind_tick(3600000, false, false, false, 0, false, false) == 1;
    assert remind_tick(-7200000, false, false, false, 0, false, false) == 0;
    assert remind_tick(1000000000000, false, true, false, 0, false, false) == 2;
    assert remind_tick(1000000000000, false, false, true, 3, false, false) == 3;
    assert remind_tick(1000000000000, true, false, true, 1, true, false) == 0;
}

pub fn slot_ping_due(hours_since_pick: u32, confirmed: bool, pinged: bool) -> bool {
    if (confirmed or pinged) { return false; }
    return hours_since_pick >= SLOT_PING_H;
}

test the_unconfirmed_slot_pings_once_after_two_hours {
    assert SLOT_PING_H == 2;
    assert slot_ping_due(2, false, false) == true;
    assert slot_ping_due(1, false, false) == false;
    assert slot_ping_due(5, true, false) == false;   // confirmed: no ping
    assert slot_ping_due(5, false, true) == false;   // once, never twice
}

/// The staff closes the slot FROM THE GROUP: confirm or cancel on the ping
/// lands in the same booking_state the TMA reads -- one store, two doors.
pub fn slot_group_action_ok(action: str) -> bool {
    return action == "confirm" or action == "cancel";
}

test the_group_closes_the_slot {
    assert slot_group_action_ok("confirm") == true;
    assert slot_group_action_ok("cancel") == true;
    assert slot_group_action_ok("snooze") == false;
}

/// Slots always name their timezone: a confused visit is worse than a
/// longer label.
pub fn slot_label_ok(has_tz: bool) -> bool {
    return has_tz;
}

test the_slot_names_its_timezone {
    assert slot_label_ok(true) == true;
    assert slot_label_ok(false) == false;
}

/// The showcase table names objects from the catalog -- an id without a
/// catalog entry renders the raw id, never an invented name.
pub fn showcase_name_ok(name: str, id: str) -> str {
    if (name != "") { return name; }
    return id;
}

test the_showcase_names_from_the_catalog {
    assert showcase_name_ok("Aileen Villas", "GV-1") == "Aileen Villas";
    assert showcase_name_ok("", "GV-1") == "GV-1";
}

/// The staff's close FROM THE GROUP reaches the client at once: the same
/// store, two doors, and both doors notify. A write that changes nothing
/// notifies no one.
pub fn group_close_notifies(prev: str, next: str) -> bool {
    if (prev == next) { return false; }
    return next == "confirmed" or next == "cancelled";
}

test the_group_close_tells_the_client {
    assert group_close_notifies("booked", "confirmed") == true;
    assert group_close_notifies("booked", "cancelled") == true;
    assert group_close_notifies("confirmed", "confirmed") == false;
    assert group_close_notifies("cancelled", "cancelled") == false;
}

/// The funnel counts what people DID: a click on an object exists only
/// with the object's id and a real timestamp.
pub fn object_click_ok(object_id: str, ms: u64) -> bool {
    return object_id != "" and ms > 0;
}

test the_object_click_carries_id_and_time {
    assert object_click_ok("GV-OBJ-260805-SITE-0222", 1790000000000) == true;
    assert object_click_ok("", 1790000000000) == false;
    assert object_click_ok("GV-OBJ-260805-SITE-0222", 0) == false;
}

/// The manager's rank table (in the TMA) lists only options that were
/// actually SERVED -- an unshown option is still the law's hand, not a row.
pub fn rank_row_visible(shows: u32) -> bool {
    return shows > 0;
}

test the_rank_table_lists_what_was_served {
    assert rank_row_visible(0) == false;
    assert rank_row_visible(1) == true;
    assert rank_row_visible(10) == true;
}

/// The notice KIND the group's close produces -- the whole decision, no
/// words: 0 = no notice (the row was not open, or the action is not a
/// close), 1 = photo confirm, 2 = text confirm, 3 = photo cancel,
/// 4 = text cancel. The words live in data (templates); the decision
/// lives here, verified by t27b. The binary interface speaks INTEGER
/// CODES only: a generated C body compares strings by pointer, so
/// statuses and actions cross the boundary as the codes below.
pub const NOTICE_NONE : u32 = 0;
pub const NOTICE_PHOTO_CONFIRM : u32 = 1;
pub const NOTICE_TEXT_CONFIRM : u32 = 2;
pub const NOTICE_PHOTO_CANCEL : u32 = 3;
pub const NOTICE_TEXT_CANCEL : u32 = 4;

pub const STATUS_BOOKED : u32 = 0;
pub const STATUS_CONFIRMED : u32 = 1;
pub const STATUS_CANCELLED : u32 = 2;
pub const STATUS_DONE : u32 = 3;

pub const ACTION_CONFIRM : u32 = 1;
pub const ACTION_CANCEL : u32 = 2;

pub fn notice_kind(prev: u32, action: u32, has_photo: bool) -> u32 {
    if (action != ACTION_CONFIRM and action != ACTION_CANCEL) { return NOTICE_NONE; }
    if (prev != STATUS_BOOKED) { return NOTICE_NONE; }
    if (action == ACTION_CONFIRM) {
        if (has_photo) { return NOTICE_PHOTO_CONFIRM; }
        return NOTICE_TEXT_CONFIRM;
    }
    if (has_photo) { return NOTICE_PHOTO_CANCEL; }
    return NOTICE_TEXT_CANCEL;
}

test the_notice_kind_covers_every_case {
    assert notice_kind(STATUS_BOOKED, ACTION_CONFIRM, true) == NOTICE_PHOTO_CONFIRM;
    assert notice_kind(STATUS_BOOKED, ACTION_CONFIRM, false) == NOTICE_TEXT_CONFIRM;
    assert notice_kind(STATUS_BOOKED, ACTION_CANCEL, true) == NOTICE_PHOTO_CANCEL;
    assert notice_kind(STATUS_BOOKED, ACTION_CANCEL, false) == NOTICE_TEXT_CANCEL;
    assert notice_kind(STATUS_CONFIRMED, ACTION_CONFIRM, true) == NOTICE_NONE;
    assert notice_kind(STATUS_CANCELLED, ACTION_CANCEL, false) == NOTICE_NONE;
    assert notice_kind(STATUS_DONE, ACTION_CONFIRM, false) == NOTICE_NONE;
    assert notice_kind(STATUS_BOOKED, 7, true) == NOTICE_NONE;
}

/// The funnel sort: bookings first, then clicks, then shows. The row that
/// converts ranks above the row that only shows.
pub fn funnel_ranks_first(a_book: u32, a_click: u32, a_shown: u32, b_book: u32, b_click: u32, b_shown: u32) -> bool {
    if (a_book != b_book) { return a_book > b_book; }
    if (a_click != b_click) { return a_click > b_click; }
    return a_shown < b_shown;
}

test the_funnel_sorts_by_conversion {
    assert funnel_ranks_first(1, 0, 2, 0, 5, 9) == true;
    assert funnel_ranks_first(0, 5, 9, 1, 0, 2) == false;
    assert funnel_ranks_first(1, 3, 2, 1, 2, 8) == true;
    assert funnel_ranks_first(1, 2, 9, 1, 3, 2) == false;
    assert funnel_ranks_first(2, 1, 1, 2, 1, 5) == true;
    assert funnel_ranks_first(2, 1, 5, 2, 1, 1) == false;
}
